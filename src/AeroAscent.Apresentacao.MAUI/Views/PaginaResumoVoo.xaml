<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AeroAscent.Apresentacao.MAUI.Views.PaginaResumoVoo"
             Title="Resumo de Voo"
             BackgroundColor="#0F172A"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20" MaximumWidthRequest="500" HorizontalOptions="Center" VerticalOptions="Center">

            <!-- Cabeçalho de Finalização -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="🏁 VOO CONCLUÍDO!" FontSize="26" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                <Label Text="Confira seu desempenho e suas recompensas:" FontSize="13" TextColor="#94A3B8" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Banner Comemorativo de Novo Recorde -->
            <Border x:Name="BorderRecorde" IsVisible="False" BackgroundColor="#D97706" Stroke="#F59E0B" StrokeThickness="2" StrokeShape="RoundRectangle 14" Padding="16,10">
                <Label Text="🏆 PARABÉNS! NOVO RECORDE PESSOAL!" TextColor="White" FontAttributes="Bold" FontSize="15" HorizontalTextAlignment="Center" />
            </Border>

            <!-- Card de Extrato das Métricas de Voo -->
            <Border BackgroundColor="#1E293B" StrokeShape="RoundRectangle 16" Stroke="#334155" StrokeThickness="1" Padding="20">
                <VerticalStackLayout Spacing="14">

                    <!-- Distância -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Label Grid.Column="0" Text="📏 Distância Percorrida:" FontSize="14" TextColor="#CBD5E1" />
                        <Label x:Name="LabelDistancia" Grid.Column="2" Text="0 m (+0 💰)" FontSize="15" FontAttributes="Bold" TextColor="White" />
                    </Grid>

                    <!-- Altitude Máxima -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Label Grid.Column="0" Text="☁️ Altitude Máxima:" FontSize="14" TextColor="#CBD5E1" />
                        <Label x:Name="LabelAltitude" Grid.Column="2" Text="0 m (+0 💰)" FontSize="15" FontAttributes="Bold" TextColor="#38BDF8" />
                    </Grid>

                    <!-- Moedas Coletadas -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Label Grid.Column="0" Text="🟡 Moedas no Percurso:" FontSize="14" TextColor="#CBD5E1" />
                        <Label x:Name="LabelMoedasColetadas" Grid.Column="2" Text="+0 💰" FontSize="15" FontAttributes="Bold" TextColor="#FCD34D" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#334155" Margin="0,4" />

                    <!-- Total Ganho na Sessão -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Label Grid.Column="0" Text="💎 Total Ganho:" FontSize="16" FontAttributes="Bold" TextColor="#FBBF24" />
                        <Label x:Name="LabelTotalGanho" Grid.Column="2" Text="+0 💰" FontSize="18" FontAttributes="Bold" TextColor="#10B981" />
                    </Grid>

                    <!-- Saldo Atualizado -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Label Grid.Column="0" Text="🏦 Saldo na Carteira:" FontSize="15" FontAttributes="Bold" TextColor="#E2E8F0" />
                        <Label x:Name="LabelSaldoFinal" Grid.Column="2" Text="💰 0" FontSize="17" FontAttributes="Bold" TextColor="#FCD34D" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Botões de Ação Pós-Voo -->
            <VerticalStackLayout Spacing="12" Margin="0,10,0,0">
                <Button x:Name="BtnOficina"
                        Text="🔧 IR PARA A OFICINA &amp; UPGRADES"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="52"
                        Clicked="OnOficinaClicked" />

                <Button x:Name="BtnVoarNovamente"
                        Text="🚀 DECOLAR NOVAMENTE"
                        BackgroundColor="#10B981"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="52"
                        Clicked="OnVoarNovamenteClicked" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
